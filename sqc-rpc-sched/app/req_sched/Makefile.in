builddir	= @builddir@
srcdir	=   @srcdir@
VPATH	=   @srcdir@
MKRULES_BUILDDIR	=	@MKRULES_BUILDDIR@

TARGET_LIB              = $(APP_REQ_SCHED_LIB)
INSTALL_LIB_TARGETS     = $(TARGET_LIB)
INSTALL_LIB_DIR         = $(DEST_LIBDIR)

TARGETS                 = $(TARGET_LIB)

include $(MKRULES_BUILDDIR)/vars.mk

CPPFLAGS	+=	-I$(APP_INC_BUILDDIR)
CPPFLAGS	+=	-I$(APP_INC_SRCDIR)

DEP_LIBS	+=	$(DEP_APP_DBMGR_LIB)
DEP_LIBS	+=	$(DEP_APP_REQ_INVOKER_LIB)

SRCS		=	req_sched.c

include $(MKRULES_BUILDDIR)/rules.mk
