builddir		=	@builddir@
srcdir			=	@srcdir@
VPATH			=	@srcdir@
MKRULES_BUILDDIR	=	@MKRULES_BUILDDIR@

include $(MKRULES_BUILDDIR)/vars.mk

UT_CPPFLAGS		=	-I$(APP_INC_BUILDDIR) -I$(APP_INC_SRCDIR) -I$(APP_GRPC_BROKER_SRCDIR) -I$(JOBBROKER_INCDIR)
UT_CFLAGS		=	-Wno-format-zero-length -Wno-format-extra-args
UT_CXXFLAGS		=	-Wno-format-zero-length -Wno-format-extra-args
UT_DEP_LIBS		=	$(DEP_SQC_UTIL_LIB) $(DEP_APP_DBMGR_LIB) $(DEP_APP_JOB_SCHED_LIB) $(JOBBROKER_LIBS) \
				$(DEP_APP_SRVSESSION_LIB) $(DEP_APP_RPC_LIB) $(DEP_APP_SQC_RPC_COMMON_LIB)

LDFLAGS			+=

EXCLUDE_TESTS		=

include $(MKRULES_BUILDDIR)/unit-test.mk
