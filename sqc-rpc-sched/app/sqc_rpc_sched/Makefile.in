builddir	= @builddir@
srcdir	=   @srcdir@
VPATH	=   @srcdir@
MKRULES_BUILDDIR	=	@MKRULES_BUILDDIR@

TARGET_EXE			=	sqc_rpc_sched
INSTALL_BIN_EXE_TARGETS		=	$(TARGET_EXE)
INSTALL_BIN_EXE_DIR		=	$(DEST_BIN_EXEDIR)

TARGETS		=	$(TARGET_EXE)

include $(MKRULES_BUILDDIR)/vars.mk

SRCS		=	main.c modules.c

CPPFLAGS	+=	-I$(APP_INC_BUILDDIR)
CPPFLAGS	+=	-I$(APP_INC_SRCDIR)

DEP_LIBS	=	$(DEP_SQC_UTIL_LIB)
DEP_LIBS	+=	$(DEP_APP_MODTMPL_LIB)
DEP_LIBS	+=	$(DEP_APP_DBMGR_LIB)
DEP_LIBS	+=	$(DEP_APP_REQ_SCHED_LIB)
DEP_LIBS	+=	$(DEP_APP_REQ_INVOKER_LIB)
DEP_LIBS	+=	$(DEP_APP_SQC_RPC_COMMON_LIB)
DEP_LIBS	+=	$(DEP_APP_SRVSESSION_LIB)
DEP_LIBS	+=	$(DEP_APP_GRPC_BROKER_LIB)
DEP_LIBS	+=	$(PROTOBUF_C_LIBS)

include $(MKRULES_BUILDDIR)/rules.mk
